# ====================================
# AI Core Service Configuration
# ====================================

# Service Configuration
AI_SERVICE_PORT=5000
LOG_LEVEL=info
DEBUG=false

# LLM Provider Configuration
# Options: "openai" or "anthropic"
LLM_PROVIDER=anthropic

# OpenAI Configuration (if using openai)
OPENAI_API_KEY=sk-your-openai-api-key-here

# Anthropic Configuration (if using anthropic)
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key-here

# LLM Settings
LLM_MODEL=claude-3-sonnet-20240229
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=1000

# Vector Database Configuration
VECTOR_DB_PATH=./data/chromadb
VECTOR_DB_TYPE=chromadb
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# External Services URLs
BACKEND_URL=http://api-gateway:8000
COURSE_SERVICE_URL=http://localhost:3002
AUTH_SERVICE_URL=http://localhost:3001

# Authentication
# IMPORTANT: Must match auth-service JWT_SECRET
JWT_SECRET=your-jwt-secret-change-in-production
JWT_ALGORITHM=HS256

# Service-to-Service Authentication
# IMPORTANT: Must match SERVICE_SECRET in other services
SERVICE_SECRET=service-to-service-secret-change-in-production

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=60

# RAG Configuration
RAG_TOP_K=3
RAG_CHUNK_SIZE=500
RAG_CHUNK_OVERLAP=50

# Cache Configuration
CACHE_TTL=3600
