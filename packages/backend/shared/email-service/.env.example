# Email Service Configuration

# Email Provider: 'smtp', 'sendgrid', or 'mailgun'
EMAIL_PROVIDER=smtp

# SMTP Configuration (for Gmail, custom SMTP, etc.)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# SendGrid Configuration (if using SendGrid)
# SENDGRID_API_KEY=SG.xxxxx

# Mailgun Configuration (if using Mailgun)
# MAILGUN_API_KEY=key-xxxxx
# MAILGUN_DOMAIN=mg.yourdomain.com

# Email Sender Information
EMAIL_FROM=noreply@haracademy.com
EMAIL_FROM_NAME=Har Academy

# Frontend URL (for links in emails)
FRONTEND_URL=http://localhost:5173

# Email Options
EMAIL_ENABLED=true
EMAIL_LOG_ONLY=false

# Notes:
# - For Gmail, you need to create an "App Password" in your Google Account settings
# - For production, use SendGrid or Mailgun for better deliverability
# - Set EMAIL_LOG_ONLY=true for development to avoid sending real emails
